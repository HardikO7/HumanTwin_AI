# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: mock | gemini | watsonx | claude
# "mock" loads pre-cached JSON from backend/data/cached_llm/ — no API key needed
LLM_PROVIDER=mock

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────────
WATSONX_URL=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# ── Anthropic Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Persistence ────────────────────────────────────────────────────────────────
# Leave blank to use local JSON files in backend/data/
MONGO_URI=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
